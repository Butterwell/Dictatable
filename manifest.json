{
    "manifest_version": 3,
    "name": "Dictatable",
    "version": "0.0.1",
    "permissions": [
        "tabs",
        "activeTab",
        "scripting"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
      "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval';"
    },
    "cross_origin_embedder_policy": {
      "value": "require-corp"
    },
    "cross_origin_opener_policy": {
      "value": "same-origin"
    },
    "background": {
      "service_worker": "init.js"
    },
    "sandbox": {
      "pages": ["sandbox.html"]
    },
    "host_permissions": [
      "https://js.tensorflow.org/api/latest/"
    ],
    "icons": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  
}